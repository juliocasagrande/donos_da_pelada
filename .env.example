# Pooled connection (Neon dashboard > Connection Details > "Pooled connection").
# Use the Neon pooled endpoint for application traffic on Railway.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require&pgbouncer=true&connection_limit=3&connect_timeout=15&pool_timeout=15"
# Maximum Prisma connections per Railway replica/process. Start with 3 and tune
# using latency, P2024 errors and the Neon pooled-connections graphs.
PRISMA_CONNECTION_LIMIT="3"
# Direct (unpooled) connection, same host without "-pooler" - only used by
# `prisma migrate`/`prisma db push`, which need a real session, not PgBouncer.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=15"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-este-segredo"

MASTER_ADMIN_NAME="Administrador Master"
MASTER_ADMIN_EMAIL="admin@donodapelada.com"
MASTER_ADMIN_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="player-photos"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
